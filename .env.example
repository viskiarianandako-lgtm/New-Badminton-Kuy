# ============================================
# Badminton Kuy - Environment Variables
# ============================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.local
# 2. Get your Supabase credentials:
#    - Go to https://supabase.com
#    - Create a new project (or use existing)
#    - Go to Settings > API
#    - Copy "Project URL" and "anon public" key
# 3. Paste your credentials below
# 4. Run: npm run dev
#

# Supabase Project URL (required)
# Found in Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (required)
# Found in Supabase Dashboard > Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (server-side only, NEVER expose to client)
# Only use in API routes, never in client components
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
